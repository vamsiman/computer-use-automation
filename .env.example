# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.

# YOUR OWN Anthropic API key goes here -- get one at https://console.anthropic.com
# Needed ONLY for `cua discover`, the single run that puts a model in the loop.
# Replay, the error taxonomy, the handoff, the console and the entire test
# suite all run without it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for discovery, and for the one out-of-loop annotation call.
CUA_MODEL=claude-sonnet-5

# Credentials for the fake credit-union app in targetapp/. These are the
# defaults and they are not secret -- the application they unlock is a stand-in
# that ships in this repository. A real deployment would put its own SSO in
# front of this and these would come from a secret manager.
CUA_APP_USER=teller1
CUA_APP_PASS=demo-pass-2024
